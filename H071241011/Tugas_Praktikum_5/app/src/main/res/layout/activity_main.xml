<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:paddingTop="48dp">

            <TextView
                android:id="@+id/tvWelcomeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome, usual suspect"
                android:textColor="@color/colorPrimary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mahasiswa"
                android:textColor="@color/textColorPrimary"
                android:textSize="17sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/strokeColor"
            android:layout_marginHorizontal="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Warna Kulit"
                android:textColor="@color/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvSkinColorLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hitam"
                android:textColor="@color/textColorPrimary"
                android:textSize="13sp"
                android:layout_marginEnd="10dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchSkinColor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temukan yang seperti kamu"
            android:textColor="@color/textColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/imgPerson1"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerCrop"
                    android:background="@color/cardColor"
                    android:contentDescription="Orang 1" />

                <ImageView
                    android:id="@+id/imgPerson2"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerCrop"
                    android:background="@color/cardColor"
                    android:contentDescription="Orang 2" />

                <ImageView
                    android:id="@+id/imgPerson3"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="centerCrop"
                    android:background="@color/cardColor"
                    android:contentDescription="Orang 3" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgPerson4"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerCrop"
                    android:background="@color/cardColor"
                    android:contentDescription="Orang 4" />

                <ImageView
                    android:id="@+id/imgPerson5"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:scaleType="centerCrop"
                    android:background="@color/cardColor"
                    android:contentDescription="Orang 5" />

                <ImageView
                    android:id="@+id/imgPerson6"
                    android:layout_width="0dp"
                    android:layout_height="130dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:scaleType="centerCrop"
                    android:background="@color/cardColor"
                    android:contentDescription="Orang 6" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/strokeColor"
            android:layout_marginHorizontal="28dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📝  Catatan Pribadi"
                android:textColor="@color/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:hint="Tulis catatan kamu di sini..."
                android:textColor="@color/textColorPrimary"
                android:textColorHint="@color/textColorSecondary"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:layout_marginBottom="12dp" />

            <Button
                android:id="@+id/btnSaveNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Simpan Catatan"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/cardColor"
            android:padding="18dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="32dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🚪  Keluar"
                android:textColor="#f09595"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>